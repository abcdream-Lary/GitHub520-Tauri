{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GitHub520",
  "version": "1.0.1",
  "identifier": "com.sokach.github520",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "GitHub520",
        "width": 1120,
        "height": 720,
        "minWidth": 940,
        "minHeight": 600,
        "resizable": true,
        "decorations": false,
        "transparent": false,
        "shadow": true,
        "visible": false,
        "center": true,
        "dragDropEnabled": false,
        "theme": "Light",
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --no-sandbox --disable-gpu-sandbox --disable-gpu-compositing"
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": false
  }
}
